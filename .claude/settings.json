{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.ferrule/ferrule hook session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.ferrule/ferrule hook shell"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.ferrule/ferrule hook attribution"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)",
      "Edit(**/.ferrule/state.db)",
      "Write(**/.ferrule/state.db)",
      "Edit(**/.ferrule/ferrule.lock)",
      "Write(**/.ferrule/ferrule.lock)",
      "Edit(**/.claude/agents/fe-*.md)",
      "Write(**/.claude/agents/fe-*.md)",
      "Edit(**/.claude/skills/fe-*/SKILL.md)",
      "Write(**/.claude/skills/fe-*/SKILL.md)"
    ]
  }
}
