{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.ferrule/ferrule hook shell"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.ferrule/ferrule hook attribution"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.ferrule/ferrule hook session-start"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git commit)",
      "Bash(git commit :*)",
      "Bash(git push)",
      "Bash(git push :*)",
      "Bash(git merge)",
      "Bash(git merge :*)",
      "Bash(git cherry-pick)",
      "Bash(git cherry-pick :*)",
      "Bash(git revert)",
      "Bash(git revert :*)",
      "Bash(git am)",
      "Bash(git am :*)",
      "Bash(git commit-tree)",
      "Bash(git commit-tree :*)",
      "Bash(git send-pack)",
      "Bash(git send-pack :*)",
      "Bash(git worktree add)",
      "Bash(git worktree add :*)",
      "Bash(git worktree remove)",
      "Bash(git worktree remove :*)",
      "Bash(gh issue create)",
      "Bash(gh issue create :*)",
      "Bash(gh issue new)",
      "Bash(gh issue new :*)",
      "Bash(gh issue edit)",
      "Bash(gh issue edit :*)",
      "Bash(gh issue comment)",
      "Bash(gh issue comment :*)",
      "Bash(gh pr create)",
      "Bash(gh pr create :*)",
      "Bash(gh pr new)",
      "Bash(gh pr new :*)",
      "Bash(gh pr edit)",
      "Bash(gh pr edit :*)",
      "Bash(gh pr ready)",
      "Bash(gh pr ready :*)",
      "Bash(gh pr comment)",
      "Bash(gh pr comment :*)",
      "Bash(gh issue view)",
      "Bash(gh issue view :*)",
      "Bash(gh pr view)",
      "Bash(gh pr view :*)",
      "Edit(**/.ferrule/state.db)",
      "Edit(**/.ferrule/ferrule.lock)",
      "Edit(**/.ferrule/ferrule.toml)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/agents/fe-*.md)",
      "Edit(**/.claude/skills/fe-*/SKILL.md)"
    ]
  }
}
