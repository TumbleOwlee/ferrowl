$ card-move.sh rp inprogress
$ card-move.sh rp.s0 inprogress
$ card-log.sh rp.s0 green
$ card-move.sh rp.s0 inreview
impl: status=inreview stage=s0 delta=0
$ card-log.sh rp.s0 commit=1b8d0dd
impl: status=committed stage=s0 sha=1b8d0dd delta=0
$ sha-check.sh rp s0 1b8d0dd
sha=ok
$ card-log.sh rp gauntlet=pass cov=81% sha=1b8d0dd
$ card-move.sh rp.s0 done

## the session dies after s1's card claims a commit that never landed
$ card-move.sh rp.s1 inprogress
$ card-log.sh rp.s1 green
$ card-move.sh rp.s1 inreview
impl: status=inreview stage=s1 delta=0
$ card-log.sh rp.s1 commit=0badc0d
board:
  open/rp.s2.md
  inprogress/rp.md
  inreview/rp.s1.md
  done/rp.s0.md

## resume: reconcile before acting
$ reconcile.sh rp
differ row=commit s1 0badc0d does not exist
reconcile=differ n=1 next=s1
$ sha-check.sh rp s1 0badc0d
sha=mismatch reason=missing
$ card-move.sh rp.s1 done
card-move=refused from=inreview to=done reason=unverified

## the worktree is gone as well
$ reconcile.sh rp
differ row=worktree <R>/.claude/worktrees/rp missing
differ row=commit s1 0badc0d does not exist
reconcile=differ n=2 next=s1
exit=0
